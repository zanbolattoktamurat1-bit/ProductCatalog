@model ProductCatalog.Models.Product

<section class="page-banner">
    <div class="container">
        <a class="back-link" asp-controller="Product" asp-action="Index">← Каталогқа оралу</a>
        <span class="eyebrow">ТАУАР ТУРАЛЫ АҚПАРАТ</span>
        <h1>@Model.Name</h1>
    </div>
</section>

<section class="container detail-section">
    <div class="row g-5 align-items-center">
        <div class="col-12 col-lg-6">
            <div class="detail-visual" aria-hidden="true">
                <span class="detail-initial">@Model.Name.Substring(0, 1)</span>
                <span class="detail-ring detail-ring-one"></span>
                <span class="detail-ring detail-ring-two"></span>
                <span class="detail-star">✦</span>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <span class="detail-category">@Model.Category</span>
            <h2 class="detail-title">@Model.Name</h2>
            <p class="detail-description">
                Сапалы әрі заманауи @Model.Name.ToLowerInvariant() — күнделікті қолдануға арналған сенімді таңдау.
                Тауардың бар-жоғын төмендегі мәртебеден тексеріңіз.
            </p>
            <div class="detail-price">@Model.Price.ToString("N0") <span>₸</span></div>
            <p class="detail-availability @(Model.IsAvailable ? "text-available" : "text-unavailable")">
                <span class="availability-dot @(Model.IsAvailable ? "is-available" : "is-unavailable")"></span>
                @(Model.IsAvailable ? "Қоймада бар" : "Қазір қолжетімсіз")
            </p>
            <div class="detail-actions">
                @if (Model.IsAvailable)
                {
                    <a class="btn btn-detail-primary" asp-controller="Product" asp-action="Create">Тағы тауар қосу</a>
                }
                else
                {
                    <button class="btn btn-detail-primary" type="button" disabled>Уақытша қолжетімсіз</button>
                }
                <a class="btn btn-detail-secondary" asp-controller="Product" asp-action="Index">Каталогқа оралу</a>
            </div>
        </div>
    </div>
</section>
