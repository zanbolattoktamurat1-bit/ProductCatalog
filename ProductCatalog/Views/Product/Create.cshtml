@model ProductCatalog.Models.Product

<section class="page-banner">
    <div class="container">
        <a class="back-link" asp-controller="Product" asp-action="Index">← Каталогқа оралу</a>
        <span class="eyebrow">КАТАЛОГТЫ ЖАҢАРТУ</span>
        <h1>Жаңа тауар қосу</h1>
        <p>Тауар туралы ақпаратты толтырып, каталогқа енгізіңіз.</p>
    </div>
</section>

<section class="container form-section">
    <div class="product-form-card">
        <div class="form-card-heading">
            <span class="form-heading-icon" aria-hidden="true">+</span>
            <div>
                <h2>Тауар мәліметтері</h2>
                <p>Тауар туралы қажетті мәліметтерді толтырыңыз.</p>
            </div>
        </div>

        <form asp-controller="Product" asp-action="Create" method="post" data-submit-feedback>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="Мысалы: Ойынға арналған ноутбук" autocomplete="off" required />
                <span asp-validation-for="Name" class="field-validation"></span>
            </div>
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <label asp-for="Price" class="form-label"></label>
                    <div class="input-group input-group-lg">
                        <input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" placeholder="0" required />
                        <span class="input-group-text">₸</span>
                    </div>
                    <span asp-validation-for="Price" class="field-validation"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="ViewBag.CategoryOptions" class="form-select form-select-lg" required>
                        <option value="">Категорияны таңдаңыз</option>
                    </select>
                    <span asp-validation-for="Category" class="field-validation"></span>
                </div>
            </div>
            <div class="availability-option form-check form-switch">
                <input asp-for="IsAvailable" class="form-check-input" role="switch" />
                <label asp-for="IsAvailable" class="form-check-label"></label>
                <p class="form-hint">Белгі қойылса, тауар каталогта қолжетімді деп көрсетіледі.</p>
            </div>
            <div class="form-actions">
                <button class="btn btn-detail-primary submit-button" type="submit">Тауарды сақтау</button>
                <a class="btn btn-detail-secondary" asp-controller="Product" asp-action="Index">Болдырмау</a>
            </div>
        </form>
    </div>
</section>
