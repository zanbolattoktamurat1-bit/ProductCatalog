@model ProductCatalog.Models.Product

<article class="card product-card h-100">
    <div class="product-card-top">
        <span class="product-category">@Model.Category</span>
        <span class="availability-dot @(Model.IsAvailable ? "is-available" : "is-unavailable")"
              aria-label="@(Model.IsAvailable ? "Қолжетімді" : "Қолжетімсіз")"></span>
    </div>
    <div class="product-visual" aria-hidden="true">
        <span class="product-initial">@Model.Name.Substring(0, 1)</span>
        <span class="visual-orbit orbit-one"></span>
        <span class="visual-orbit orbit-two"></span>
    </div>
    <div class="card-body d-flex flex-column">
        <h2 class="product-name">@Model.Name</h2>
        <p class="product-status @(Model.IsAvailable ? "text-available" : "text-unavailable")">
            @(Model.IsAvailable ? "Қоймада бар" : "Қазір қолжетімсіз")
        </p>
        <div class="mt-auto d-flex justify-content-between align-items-center gap-2 pt-3">
            <p class="product-price mb-0">@Model.Price.ToString("N0") <span>₸</span></p>
            <a class="btn btn-product-details" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
                Толығырақ
            </a>
        </div>
    </div>
</article>
